{
  // Cloudflare Worker + Container wrapper for the patient-service Express app.
  // Deploy with: npx wrangler deploy  (Docker must be running locally)
  "account_id": "793968892828e043e9d9dcb8ca1447f6",
  "name": "agentfleet-patient-service",
  "main": "worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],

  // Build the existing Dockerfile into a container image and run it behind a Durable Object.
  "containers": [
    {
      "class_name": "PatientContainer",
      "image": "./Dockerfile",
      "max_instances": 3
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "PATIENT_CONTAINER",
        "class_name": "PatientContainer"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PatientContainer"]
    }
  ],

  // Hyperdrive pools + caches connections to the Neon Postgres database.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "c29c83df22504223bc378a9924e020a1"
    }
  ],

  // Non-secret vars. Set CORS_ORIGIN to your deployed frontend origin.
  // Secret (JWT_SECRET) is provided via `wrangler secret put` and MUST match auth-service.
  "vars": {
    "NODE_ENV": "production",
    "PORT": "3010",
    "CORS_ORIGIN": "https://agentfleet-ai.pages.dev"
  }
}
