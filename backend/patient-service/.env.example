PORT=3010
DATABASE_URL=postgresql://user:password@localhost:5432/agentfleet
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:5173

# Campaigns are queued by the API. A worker may use this provider identifier to
# dispatch queued messages; keep provider credentials in your deployment secret store.
MESSAGE_DELIVERY_PROVIDER=twilio